# Postgres
DATABASE_URL=postgres://tachy:tachy@localhost:5433/tachy
PORT=8787

# debug | info | warn | error. debug includes the /health healthcheck line.
LOG_LEVEL=info

# docker-compose only; keep consistent with DATABASE_URL
POSTGRES_USER=tachy
POSTGRES_PASSWORD=tachy
POSTGRES_DB=tachy

# Credential vault master key (openssl rand -base64 32).
# Unset = vault disabled; source tokens and agent keys can't be stored in-app.
# TACHY_SECRET_KEY=

# Session cookie signing secret (32+ chars).
# Unset = everyone is logged out on every restart.
# TACHY_SESSION_SECRET=

# Bearer token for REST automation (scripts, CI). Optional.
# TACHY_API_TOKEN=

# OIDC SSO (Microsoft Entra or any provider). Optional.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=

# OIDC_AUTH_SECRET is accepted as an alias for TACHY_SESSION_SECRET, and
# OIDC_SCOPES overrides the default "openid profile email offline_access".
# OIDC_SCOPES=

# sso | token | open. Reported in the startup banner and Admin > System; the
# real mode is whatever is actually configured above.
# TACHY_AUTH_MODE=

# Agent defaults, overridable per user and per team in the app. Model and
# effort follow the provider; allowed_models restricts what a user may pick.
# TACHY_AGENT_PROVIDER=claude
# TACHY_AGENT_MODEL=
# TACHY_AGENT_EFFORT=medium
# TACHY_ALLOWED_MODELS=

# Fallbacks used when the vault holds no credential for the caller. Copilot
# also accepts GH_TOKEN or GITHUB_TOKEN, in that order.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# COPILOT_GITHUB_TOKEN=

# Scrub PII from LLM-facing copies deployment-wide. The `redaction_global`
# setting in Admin > System is the same switch, and the one to prefer.
# TACHY_REDACT=

# How long a generated export stays downloadable (default 24).
# TACHY_OUTPUT_TTL_HOURS=

# Milliseconds an approval box waits before the turn gives up (default 900000).
# TACHY_APPROVAL_TIMEOUT_MS=

# Data paths. The Docker image sets all three; set them only outside Docker.
# TACHY_REPO_DIR=
# TACHY_UPLOAD_DIR=
# TACHY_MODEL_CACHE=
# TACHY_AGENT_HOME=

# Where the API looks for the built SPA (default packages/web/dist).
# TACHY_WEB_ROOT=

# Swap the embedding model. Changing it invalidates every stored vector:
# back up, recreate, restore, then `npm run sync reembed`.
# TACHY_EMBED_MODEL=

# How the API spawns the MCP server for an agent turn. Defaults are correct
# for a source checkout; set them only if that layout differs.
# TACHY_MCP_COMMAND=
# TACHY_MCP_ARGS=

# Attribution for writes made by a standalone MCP client rather than the web
# chat -- the address those rows are recorded against.
# TACHY_USER_EMAIL=

