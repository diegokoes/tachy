# /etc/tachy/tachy.env: settings for the host scripts (tachy-backup,
# tachy-watch, tachy-deploy). root:root 0600. Secrets here also live in the
# password manager. The app's own secrets stay in /opt/tachy/.env.

TACHY_DIR=/opt/tachy
TACHY_SRV=/srv/tachy
TACHY_COMPOSE_FILES="-f docker-compose.yml -f deploy/compose.prod.yml"

# Public halves of the team backup key and the break-glass key, one per line.
TACHY_BACKUP_RECIPIENTS=/etc/tachy/backup-recipients.txt

# healthchecks.io ping URLs, one check each. Leave empty to disable.
HC_BACKUP_URL=
HC_RESTORE_URL=
