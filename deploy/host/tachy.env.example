# /etc/tachy/tachy.env: settings for the host scripts (tachy-backup,
# tachy-watch, tachy-deploy). root:tachy 0640. Secrets here also live in the
# password manager. The app's own secrets stay in /opt/tachy/.env.

TACHY_DIR=/opt/tachy
TACHY_SRV=/srv/tachy
TACHY_COMPOSE_FILES="-f docker-compose.yml -f deploy/compose.prod.yml"

# Public halves of the team backup key and the break-glass key, one per line.
TACHY_BACKUP_RECIPIENTS=/etc/tachy/backup-recipients.txt
# Memory limit of the restore test's scratch Postgres. 0 lifts it.
# TACHY_RESTORE_MEM_LIMIT=1g

# healthchecks.io ping URLs, one check each. Leave empty to disable.
HC_BACKUP_URL=
HC_RESTORE_URL=
HC_WATCH_URL=

# tachy-watch posts alerts to a Teams workflow ("When a Teams webhook request
# is received"). Give the workflow a co-owner, or it is orphaned when its owner
# leaves. The URL is a secret.
TEAMS_WEBHOOK_URL=
# What tachy-watch reads the api's runtime block with: a token minted for a
# service account (first-install.md). A member's rights are enough. Empty: the
# stack's TACHY_API_TOKEN, where one is still set.
WATCH_API_TOKEN=
# Caddy's root certificate, so the readyz check verifies TLS instead of -k.
TACHY_CA_FILE=/etc/tachy/caddy-root.crt
# Space-separated mounts to watch, and the NVMe device.
WATCH_MOUNTS="/ /var /srv"
WATCH_NVME=/dev/nvme0
# 0 until the backup downloaders exist, or the check fails every run.
WATCH_DOWNLOADS=1

# tachy-deploy: where CI pushes images, and the load-test account smoke.js
# logs in as after every deploy (a service account allowed password login).
TACHY_IMAGE_REPO=ghcr.io/diegokoes/tachy
# Deploys run as tachy; the backup directories are root's.
TACHY_BACKUP_BIN="sudo -n /usr/local/bin/tachy-backup"
SMOKE_EMAIL=
SMOKE_PASSWORD=

# tachy-update: the branch whose head is deployed by itself, at 01:15 and again
# at 04:45 (tachy-update.timer). Empty: every deploy is by hand.
TACHY_UPDATE_BRANCH=
# `skip` lets those deploys go without the smoke run, for a host that has no
# smoke account yet. Readiness is still checked, and a failure rolled back.
# TACHY_UPDATE_SMOKE=run
