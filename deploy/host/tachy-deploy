#!/usr/bin/env bash
# Deploys a commit that CI has built (DEPLOYMENT-ARCHITECTURE.md §10), as the
# `tachy` user or root, on the host. The host never builds.
#
#   tachy-deploy <commit|branch>      deploy it; roll back by itself on failure
#   tachy-deploy <commit> --no-pull   the image is already local (tagged sha-<commit>)
#   tachy-deploy stamp                record that the live database matches the
#                                     checked-out db/schema.sql (once, after
#                                     verifying it by hand on a pre-stamp database)
#
#   tachy-deploy <commit> --allow-destructive
#                                     apply a schema plan that drops or rewrites
#                                     data (pg-schema-diff hazards; see
#                                     deploy/postgres/schema-hazards.sh)
#   tachy-deploy <commit> --skip-smoke
#                                     deploy without the smoke run, which
#                                     otherwise needs SMOKE_EMAIL and
#                                     SMOKE_PASSWORD; recorded as skipped
#
# Rollback is `tachy-deploy <previous commit>`: safe while the previous image
# accepts the current schema, which is what expand-and-contract is for.
set -euo pipefail

HERE=$(dirname "$(readlink -f "$0")")
# shellcheck source=common.sh
. "${TACHY_COMMON:-$HERE/common.sh}"
# shellcheck source=../postgres/schema-hazards.sh
. "${TACHY_HAZARDS:-$HERE/../postgres/schema-hazards.sh}"

IMAGE_REPO=${TACHY_IMAGE_REPO:-ghcr.io/diegokoes/tachy}
DEPLOY_LOG=${TACHY_DEPLOY_LOG:-$TACHY_SRV/deploy.log}
READY_TIMEOUT=${TACHY_READY_TIMEOUT:-300}
read -ra BACKUP <<<"${TACHY_BACKUP_BIN:-tachy-backup}"

PULL=true
ALLOW_DESTRUCTIVE=false
SMOKE=run
TARGET=""
for arg in "$@"; do
  case "$arg" in
  --no-pull) PULL=false ;;
  --allow-destructive) ALLOW_DESTRUCTIVE=true ;;
  --skip-smoke) SMOKE=skipped ;;
  -*) echo "unknown option $arg" >&2; exit 2 ;;
  *) TARGET=$arg ;;
  esac
done
[ -n "$TARGET" ] || { echo "usage: tachy-deploy <commit|branch> [--no-pull] [--allow-destructive] [--skip-smoke] | stamp" >&2; exit 2; }

exec 9>"${TACHY_DEPLOY_LOCK:-/tmp/tachy-deploy.lock}"
flock -n 9 || { echo "another deploy is running" >&2; exit 1; }

git_() { git -C "$TACHY_DIR" "$@"; }

pg_owner() {
  dc exec -T postgres psql -v ON_ERROR_STOP=1 -At -U "$(app_env POSTGRES_USER tachy)" \
    -d "$(app_env POSTGRES_DB tachy)" "$@" </dev/null
}

live_stamp() {
  pg_owner -c "select coalesce((select schema_sha256 from schema_meta where id), 'unstamped')" 2>/dev/null ||
    echo unreachable
}

stamp_now() {
  local hash=${1:-}
  [ -n "$hash" ] || hash=$(sha256sum "$TACHY_DIR/db/schema.sql" | cut -d' ' -f1)
  pg_owner -c "insert into schema_meta (schema_sha256) values ('$hash')
    on conflict (id) do update set schema_sha256 = excluded.schema_sha256, applied_at = now()" >/dev/null
  log "schema stamped $hash"
}

# restore_stamp <stamp before the deploy> <stamp the deploy set>
#
# A release reports ready only on the schema it was built against, so after a
# rollback the previous release would refuse a database stamped for the new
# one, and Caddy would route to nothing. The schema itself stays as the new
# release left it, which the previous release accepts as long as the change was
# additive (deploy/runbooks/schema-change.md).
restore_stamp() {
  local before=$1 set_by_deploy=$2
  [ "$before" != "$set_by_deploy" ] || return 0
  case "$before" in
  unstamped)
    pg_owner -c "delete from schema_meta" >/dev/null
    log "schema stamp removed, as it was before this deploy"
    ;;
  unreachable) ;;
  *) stamp_now "$before" ;;
  esac
}

if [ "$TARGET" = stamp ]; then
  stamp_now
  exit 0
fi

set_env() {
  local key=$1 value=$2 file="$TACHY_DIR/.env"
  if grep -q "^$key=" "$file"; then
    sed -i "s|^$key=.*|$key=$value|" "$file"
  else
    printf '%s=%s\n' "$key" "$value" >>"$file"
  fi
}

wait_ready() {
  local host deadline
  host=$(app_env TACHY_HOSTNAME localhost)
  deadline=$(($(date +%s) + READY_TIMEOUT))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    if curl -fsk -m 5 --resolve "$host:${TACHY_HTTPS_PORT:-443}:127.0.0.1" \
      "https://$host:${TACHY_HTTPS_PORT:-443}/readyz" 2>/dev/null | grep -q '"ready":true'; then
      return 0
    fi
    sleep 3
  done
  return 1
}

smoke() {
  if [ "$SMOKE" = skipped ]; then
    log "smoke skipped: --skip-smoke"
    return 0
  fi
  # The k6 the release's own scripts are written for.
  local image
  image=${TACHY_K6_IMAGE:-$(sed -n 's/^ *image: *\(grafana\/k6:[^ ]*\) *$/\1/p' "$TACHY_DIR/load/k6.compose.yml")}
  docker run --rm --network "$(project)" -v "$TACHY_DIR/load:/load:ro" \
    -e BASE_URL=http://api:8787 -e LOGIN_EMAIL="$SMOKE_EMAIL" -e LOGIN_PASSWORD="$SMOKE_PASSWORD" \
    "$image" run --quiet /load/smoke.js
}

resolve_image() {
  local sha=$1 tag digest
  tag="$IMAGE_REPO:sha-${sha:0:12}"
  $PULL && docker pull -q "$tag" >/dev/null
  digest=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$tag" 2>/dev/null |
    grep "^$IMAGE_REPO@" | head -1)
  echo "${digest:-$tag}"
}

# roll <commit> <image>: check out the commit, point .env at the image, recreate
roll() {
  git_ checkout -q --detach "$1"
  set_env TACHY_IMAGE "$2"
  set_env TACHY_COMMIT "${1:0:12}"
  dc up -d --remove-orphans
}

record() {
  local line
  line=$(jq -nc --arg at "$(utc_now)" --arg commit "$1" --arg image "$2" \
    --arg previous "$3" --arg schema "$4" --arg result "$5" --arg by "${SUDO_USER:-$(id -un)}" \
    --arg smoke "$SMOKE" \
    '{at: $at, commit: $commit, image: $image, previous: $previous, schema: $schema, result: $result, smoke: $smoke, by: $by}')
  mkdir -p "$(dirname "$DEPLOY_LOG")"
  printf '%s\n' "$line" >>"$DEPLOY_LOG"
  write_status release "$line"
  append_history release "$line"
}

if [ "$SMOKE" = run ] && { [ -z "${SMOKE_EMAIL:-}" ] || [ -z "${SMOKE_PASSWORD:-}" ]; }; then
  echo "SMOKE_EMAIL and SMOKE_PASSWORD are not set in $TACHY_ENV_FILE, so the deploy would go unchecked. Set them, or pass --skip-smoke." >&2
  exit 2
fi

git_ fetch -q --all --prune
if git_ rev-parse -q --verify "origin/$TARGET^{commit}" >/dev/null; then
  COMMIT=$(git_ rev-parse "origin/$TARGET^{commit}")
else
  COMMIT=$(git_ rev-parse "$TARGET^{commit}")
fi
PREV_COMMIT=$(git_ rev-parse HEAD)
PREV_IMAGE=$(app_env TACHY_IMAGE)
log "deploying $COMMIT (from ${PREV_COMMIT:0:12}, image $PREV_IMAGE)"

IMAGE=$(resolve_image "$COMMIT")
docker image inspect "$IMAGE" >/dev/null || { log "image $IMAGE is not available"; exit 1; }
log "image $IMAGE"

# schema_diff <plan|apply> [args]: pg-schema-diff from the new image, against the
# live database, to the new image's db/schema.sql and db/roles.sql (the tool
# loads a directory in lexical order, and the live grants come from roles.sql).
schema_diff() {
  local cmd=$1
  shift
  docker run --rm --network "$(project)" --entrypoint sh \
    -e PGPASSWORD="$(app_env POSTGRES_PASSWORD)" "$IMAGE" -c '
      mkdir -p /tmp/target && cp /app/db/schema.sql /tmp/target/10-schema.sql &&
      cp /app/db/roles.sql /tmp/target/20-roles.sql &&
      exec pg-schema-diff "$@" --to-dir /tmp/target --data-pack-new-tables=false' \
    schema-diff "$cmd" \
    --from-dsn "postgres://$(app_env POSTGRES_USER tachy)@postgres:5432/$(app_env POSTGRES_DB tachy)?sslmode=disable" \
    "$@"
}

# After a pgvector image bump the library is newer than the installed extension,
# and the plan's validation cannot recreate the old version; bring it level first.
pg_owner -c "alter extension vector update" >/dev/null

NEW_SCHEMA=$(git_ show "$COMMIT:db/schema.sql" | sha256sum | cut -d' ' -f1)
LIVE_SCHEMA=$(live_stamp)
SCHEMA=unchanged
DESTRUCTIVE=
PLAN=$(schema_diff plan --output-format json)
STATEMENTS=$(jq '.statements | length' <<<"${PLAN:-"{\"statements\":[]}"}")
if [ "$STATEMENTS" -gt 0 ]; then
  SCHEMA=planned
  log "schema plan: $STATEMENTS statement(s)"
  jq -r '.statements[] | "  \(.ddl)" + (if (.hazards // []) | length > 0 then "  [" + ([.hazards[].type] | join(", ")) + "]" else "" end)' <<<"$PLAN" >&2
  DESTRUCTIVE=$(jq -r --arg d "$SCHEMA_DESTRUCTIVE_HAZARDS" \
    '[.statements[].hazards[]?.type] | map(select(. as $t | ($d | split(",") | index($t)))) | unique | join(",")' <<<"$PLAN")
  if [ -n "$DESTRUCTIVE" ] && ! $ALLOW_DESTRUCTIVE; then
    record "$COMMIT" "$IMAGE" "$PREV_IMAGE" "destructive: $DESTRUCTIVE" "refused"
    log "refused: the schema plan has destructive hazards ($DESTRUCTIVE). Read it, then rerun with --allow-destructive."
    exit 1
  fi
elif [ "$LIVE_SCHEMA" != "$NEW_SCHEMA" ]; then
  SCHEMA=stamped
fi

log "pre-deploy backup"
"${BACKUP[@]}" db

if [ "$SCHEMA" = planned ]; then
  allow=$SCHEMA_SAFE_HAZARDS
  $ALLOW_DESTRUCTIVE && allow="$allow,$SCHEMA_DESTRUCTIVE_HAZARDS"
  log "applying the schema plan"
  schema_diff apply --allow-hazards "$allow" --skip-confirm-prompt >&2
  SCHEMA=applied
fi
[ "$LIVE_SCHEMA" = "$NEW_SCHEMA" ] || stamp_now "$NEW_SCHEMA"

# The new release's roles and their passwords, before anything of it starts.
# Both are idempotent.
git_ show "$COMMIT:db/roles.sql" |
  dc exec -T postgres psql -v ON_ERROR_STOP=1 -q -U "$(app_env POSTGRES_USER tachy)" \
    -d "$(app_env POSTGRES_DB tachy)" -f /dev/stdin >/dev/null
git_ show "$COMMIT:deploy/postgres/role-passwords.sh" |
  dc exec -T -e TACHY_APP_DB_PASSWORD="$(app_env TACHY_APP_DB_PASSWORD)" \
    -e TACHY_MCP_DB_PASSWORD="$(app_env TACHY_MCP_DB_PASSWORD)" \
    -e TACHY_BACKUP_DB_PASSWORD="$(app_env TACHY_BACKUP_DB_PASSWORD)" postgres bash -s >/dev/null

roll "$COMMIT" "$IMAGE"

if wait_ready && smoke; then
  record "$COMMIT" "$IMAGE" "$PREV_IMAGE" "$SCHEMA" "deployed"
  log "deployed $COMMIT"
  exit 0
fi

log "deploy failed; rolling back to ${PREV_COMMIT:0:12} ($PREV_IMAGE)"
dc logs --tail 50 api >&2 || true
if [ "$SCHEMA" = applied ] && [ -n "$DESTRUCTIVE" ]; then
  # Something the previous release may read is gone. It stays not ready
  # instead of serving on a schema it cannot be trusted with.
  log "the applied plan was destructive ($DESTRUCTIVE): the stamp stays, and the previous release will not report ready. Restore the pre-deploy backup, or fix forward."
else
  restore_stamp "$LIVE_SCHEMA" "$NEW_SCHEMA"
fi
roll "$PREV_COMMIT" "$PREV_IMAGE"
if wait_ready; then
  record "$COMMIT" "$IMAGE" "$PREV_IMAGE" "$SCHEMA" "rolled_back"
  log "rolled back to ${PREV_COMMIT:0:12}"
else
  record "$COMMIT" "$IMAGE" "$PREV_IMAGE" "$SCHEMA" "rollback_failed"
  log "ROLLBACK FAILED: the previous release is not ready either"
fi
exit 1
