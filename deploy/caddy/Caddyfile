# The only published service (DEPLOYMENT-ARCHITECTURE.md §5.7).
#
# TACHY_HOSTNAME  the name clients use, e.g. tachy.office.lan, or tachy.local
#                 where mDNS is all there is. Never an IP: the OIDC redirect
#                 and the host scripts bind to it.
# TACHY_HOST_IP   the host's address, for clients that cannot resolve the name
#                 yet: the site answers on it too. A client sends no server
#                 name for an IP, so that certificate is also the one served
#                 when none is sent. Works with TACHY_TLS=internal only: a
#                 certificate issued elsewhere covers the names it was issued
#                 for.
# TACHY_TLS       `internal` (default): Caddy's own CA signs the certificate and
#                 renews it; clients install its root once (deploy/runbooks).
#                 `/certs/tachy.crt /certs/tachy.key`: a certificate issued
#                 elsewhere, e.g. by IT, mounted read-only at /certs.
{
	admin off
	skip_install_trust
	default_sni {$TACHY_DEFAULT_SNI}
}

{$TACHY_HOSTNAME} {$TACHY_HOST_IP} {
	tls {$TACHY_TLS:internal}

	# The api sets the content policy and the other response headers itself, so
	# a deployment without this proxy has them. Only what needs TLS is set here.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# For the MCP children inside the api container only.
	@internal path /internal /internal/*
	respond @internal 404

	# 25 MB chat uploads plus multipart overhead.
	request_body {
		max_size 26MB
	}

	reverse_proxy api:8787 {
		flush_interval -1
		health_uri /readyz
		health_interval 10s
		health_timeout 5s
	}
}
