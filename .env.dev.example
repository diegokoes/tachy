# The dev stack: a second compose project on the same host as production.
# Copy to .env in a separate checkout (e.g. /opt/tachy-dev on the dev branch).
# Everything the two stacks must not share is set here.

COMPOSE_PROJECT_NAME=tachy-dev
TACHY_API_PORT=8788
TACHY_PG_PORT=5434
TACHY_IMAGE=diegokoes/tachy:dev

POSTGRES_USER=tachy
POSTGRES_PASSWORD=tachy
POSTGRES_DB=tachy_dev

# Host-side URL, for running the CLI outside the containers. Compose overrides
# this inside them, so the container always talks to its own postgres.
DATABASE_URL=postgres://tachy:tachy@localhost:5434/tachy_dev
PORT=8787
LOG_LEVEL=debug

# Required, and not for the reason you would guess: with no auth configured the
# API binds to 127.0.0.1 *inside its container*, so nothing else on the compose
# network -- including k6 -- can reach it. Setting this makes it bind normally.
TACHY_API_TOKEN=change-me-dev-token

# 32+ chars, and NOT the production one: a session cookie signed by one stack
# would otherwise be accepted by the other.
TACHY_SESSION_SECRET=change-me-dev-session-secret-32-chars-min

# openssl rand -base64 32. Without it the seeder skips credentials.
# TACHY_SECRET_KEY=
